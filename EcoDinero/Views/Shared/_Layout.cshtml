<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - EcoDinero</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    @RenderSection("styles", required: false)
</head>
<body>
    @*Quien quiera que seas y lees esto,debes saber que te quiero :3*@
    @*Guacha,  navba si no te gusta cambiale color ahi en Sites.css*@
    <nav class="navbar navbar-expand-sm navbar-dark sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="@Url.Action("Index", "Home")">
                <i class="fas fa-wallet me-2 text-success"></i>EcoDinero
            </a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-end">
                <ul class="navbar-nav">
                    <li><a class="nav-link" href="@Url.Action("dashboard", "Datos")"><i class="fas fa-chart-line me-1"></i> Dashboard</a></li>
                    <li><a class="nav-link" href="@Url.Action("transacciones", "Datos")"><i class="fas fa-exchange-alt me-1"></i> Transacciones</a></li>
                    <li><a class="nav-link" href="@Url.Action("categorias", "Datos")"><i class="fas fa-tags me-1"></i> Categorías</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="main-content">
            @RenderBody()
    </main>

    <div class="container">
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - EcoDinero - Pardy - Brandy - Rellenito</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>