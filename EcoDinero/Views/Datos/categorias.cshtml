@{
    ViewBag.Title = "Categorías";
}

@section styles {
    <link href="~/Content/categorias.css" rel="stylesheet" />
}
@*Esta vista si ya empieza lo feo porque se tiene que hacer uso de la base para que se puedan agregar nuevas categorias que el usuario crea necesarias para llevar
    a cabo su administracion*@
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Gestión de categorías</h2>
            <p class="text-muted">Organiza tus finanzas por grupos personalizados</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-3 col-sm-6">
            <div class="category-card shadow-sm border-0">
                <div class="category-icon bg-light text-warning">
                    <i class="fas fa-utensils fa-2x"></i>
                </div>
                <h5 class="fw-bold mb-1">Comida</h5>
                <p class="text-muted small mb-3">12 transacciones</p>
                <div class="btn-group w-100">
                    <button class="btn btn-sm btn-outline-secondary border-0"><i class="fas fa-edit"></i></button>
                    <button class="btn btn-sm btn-outline-danger border-0"><i class="fas fa-trash"></i></button>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="category-card shadow-sm border-0">
                <div class="category-icon bg-light text-primary">
                    <i class="fas fa-car fa-2x"></i>
                </div>
                <h5 class="fw-bold mb-1">Transporte</h5>
                <p class="text-muted small mb-3">5 transacciones</p>
                <div class="btn-group w-100">
                    <button class="btn btn-sm btn-outline-secondary border-0"><i class="fas fa-edit"></i></button>
                    <button class="btn btn-sm btn-outline-danger border-0"><i class="fas fa-trash"></i></button>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="category-card shadow-sm border-0">
                <div class="category-icon bg-light text-info">
                    <i class="fas fa-gamepad fa-2x"></i>
                </div>
                <h5 class="fw-bold mb-1">Ocio</h5>
                <p class="text-muted small mb-3">3 transacciones</p>
                <div class="btn-group w-100">
                    <button class="btn btn-sm btn-outline-secondary border-0"><i class="fas fa-edit"></i></button>
                    <button class="btn btn-sm btn-outline-danger border-0"><i class="fas fa-trash"></i></button>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="category-card add-category-btn h-100 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCategoria">
                <i class="fas fa-plus-circle fa-3x mb-3"></i>
                <h5 class="fw-bold">Nueva</h5>
                <p class="small">Agregar etiqueta</p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCategoria" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold">Crear categoría</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label">Nombre de la categoría</label>
                        <input type="text" class="form-control" placeholder="Ej: Salud, Gimnasio...">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Selecciona un icono</label>
                        <div class="d-flex gap-3 fs-3 text-muted">
                            <i class="fas fa-shopping-bag p-2 border rounded cursor-pointer"></i>
                            <i class="fas fa-heartbeat p-2 border rounded cursor-pointer"></i>
                            <i class="fas fa-graduation-cap p-2 border rounded cursor-pointer"></i>
                            <i class="fas fa-home p-2 border rounded cursor-pointer"></i>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary px-4">Crear</button>
            </div>
        </div>
    </div>
</div>