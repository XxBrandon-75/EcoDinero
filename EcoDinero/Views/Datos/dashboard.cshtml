@{
    ViewBag.Title = "Dashboard";
}

@section styles {
    <link href="~/Content/dashboard.css" rel="stylesheet" />
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-danger text-white p-3 mb-4">
                <h6>Total Gastado</h6>
                <h3>$@string.Format("{0:N2}", ViewBag.TotalGastado)</h3>
                <small>en gastos registrados</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-success text-white p-3 mb-4">
                <h6>Total Ingresado</h6>
                <h3>$@string.Format("{0:N2}", ViewBag.TotalIngresado)</h3>
                <small>en ingresos registrados</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-primary text-white p-3 mb-4">
                <h6>Categorías</h6>
                <h3>@ViewBag.TotalCategorias</h3>
                <small>categorías creadas</small>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 p-4 mb-4">
                <h5 class="fw-bold mb-3"><i class="fas fa-chart-area me-2 text-danger"></i>Flujo de Gastos (Últimos 7 días)</h5>
                <canvas id="lineChartGastos" height="100"></canvas>
            </div>
            <div class="card shadow-sm border-0 p-4 mb-4">
                <h5 class="fw-bold mb-3"><i class="fas fa-chart-area me-2 text-success"></i>Flujo de Ingresos (Últimos 7 días)</h5>
                <canvas id="lineChartIngresos" height="100"></canvas>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 p-4 mb-4">
                <h5 class="fw-bold mb-3">Distribución por categoría</h5>
                <canvas id="pieChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Línea — gastos últimos 7 días
        new Chart(document.getElementById('lineChartGastos'), {
            type: 'line',
            data: {
                labels: @Html.Raw(ViewBag.LabelsLinea),
                datasets: [{
                    label: 'Gastos',
                    data: @Html.Raw(ViewBag.DatosLinea),
                    borderColor: '#e53935',
                    backgroundColor: 'rgba(229,57,53,0.1)',
                    tension: 0.4,
                    fill: true
                }]
            }
        });

        // Línea — ingresos últimos 7 días
        new Chart(document.getElementById('lineChartIngresos'), {
            type: 'line',
            data: {
                labels: @Html.Raw(ViewBag.LabelsLinea),
                datasets: [{
                    label: 'Ingresos',
                    data: @Html.Raw(ViewBag.DatosLineaIngresos),
                    borderColor: '#43a047',
                    backgroundColor: 'rgba(67,160,71,0.1)',
                    tension: 0.4,
                    fill: true
                }]
            }
        });

        // Pie — distribución por categoría
        new Chart(document.getElementById('pieChart'), {
            type: 'pie',
            data: {
                labels: @Html.Raw(ViewBag.LabelsPie),
                datasets: [{
                    data: @Html.Raw(ViewBag.DatosPie),
                    backgroundColor: ['#1a237e','#e53935','#43a047','#fb8c00','#8e24aa','#00acc1','#f4511e','#6d4c41']
                }]
            }
        });
    </script>
}