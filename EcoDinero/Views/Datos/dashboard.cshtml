
@{
    ViewBag.Title = "dashboard";
}

@section styles {
    <link href="~/Content/dashboard.css" rel="stylesheet" />
}
<h2>Me gusta la de cabello cobrizo o no me acuerdo la neta pero si me gusta pero pato me la cebo ese dia, si te acuerdas we?</h2>
@*Aqui ta mas facil porque solo es mandar a llamar a la base (que te recuerdo que no hay vea) y te muestra el presupuesto que esta relacionado con el usuario
    pero pues no hay base vea*@
<div class="container mt-4">
    <div class="row">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-primary text-white p-3 mb-4">
                <h6>Presupuesto Mensual</h6>
                <h3>$5,000.00</h3>
                <small>Restante: $1,200.00</small>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 p-4 mb-4">
                <h5 class="fw-bold mb-3"><i class="fas fa-chart-area me-2"></i>Flujo de Gastos (Últimos 7 días)</h5>
                <canvas id="lineChart" height="100"></canvas>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 p-4 mb-4">
                <h5 class="fw-bold mb-3">Distribución</h5>
                <canvas id="pieChart"></canvas>
            </div>
        </div>
    </div>
</div>
@*Aqui no te apantallei porque este me lo dio chat para rellenar pero no le hagas mucho caso es solo un script que la funcion es demostrar como van las estadisticas
    del usuario que tambien en funcion se tienen que relacionar con la base*@
@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Configuración rápida de gráficos con datos "falsos" para tu equipo
        const ctxLine = document.getElementById('lineChart');
        new Chart(ctxLine, {
            type: 'line',
            data: {
                labels: ['Lun', 'Mar', 'Mie', 'Jue', 'Vie', 'Sab', 'Dom'],
                datasets: [{ label: 'Gastos', data: [120, 190, 300, 50, 200, 300, 450], borderColor: '#1a237e', tension: 0.4 }]
            }
        });
    </script>
}