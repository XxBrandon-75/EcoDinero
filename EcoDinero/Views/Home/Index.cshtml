@{
    ViewBag.Title = "Bienvenido a  EcoDinero";
}

@section styles {
    <link href="~/Content/index.css" rel="stylesheet" />
}
<main>
    <section class="hero-banner">
        <div class="hero-overlay">
            <div class="container">
                <div class="row align-items-center justify-content-center text-center">
                    <div class="col-lg-8">
                        <h1 class="display-3 fw-bold text-white mb-3">Toma el control de tu dinero</h1>
                        <p class="lead text-white-50 mb-4">
                            La forma más inteligente y sencilla de gestionar tus gastos diarios.
                            Visualiza tus finanzas, ahorra más y alcanza tus metas hoy mismo.
                        </p>
                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                            <a href="#" class="btn btn-success btn-lg px-4 gap-3 border-0 shadow">Comenzar ahora</a>
                            <a href="#" class="btn btn-outline-light btn-lg px-4">Ver mi resumen</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="container my-5">
        <div class="row g-4 py-5 row-cols-1 row-cols-lg-3">
            <div class="feature col text-center">
                <div class="feature-icon bg-primary bg-gradient text-white mb-3">
                    <i class="fas fa-bolt fa-2x"></i>
                </div>
                <h3>Registro Rápido</h3>
                <p>Añade tus gastos en segundos desde cualquier dispositivo. Categorización inteligente automática.</p>
            </div>
            <div class="feature col text-center">
                <div class="feature-icon bg-success bg-gradient text-white mb-3">
                    <i class="fas fa-chart-pie fa-2x"></i>
                </div>
                <h3>Análisis Visual</h3>
                <p>Gráficos claros que te muestran exactamente a dónde se va tu dinero cada mes.</p>
            </div>
            <div class="feature col text-center">
                <div class="feature-icon bg-warning bg-gradient text-white mb-3">
                    <i class="fas fa-shield-alt fa-2x"></i>
                </div>
                <h3>Seguridad Total</h3>
                <p>Tus datos financieros están protegidos y solo tú tienes acceso a tu información privada.</p>
            </div>
        </div>
    </div>
</main>